<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <Optimize>true</Optimize>
    <RootNamespace>FfiSharp.Benchmarks</RootNamespace>
    <AssemblyName>FfiSharp.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FfiSharp/FfiSharp.csproj" />
    <None Include="../../tests/native/example.so" Link="example.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/native/example.h" Link="example.h" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
